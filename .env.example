# ========================================================
# GiftX - Environment Variables Example
# Duplicate this file to .env.local for local overrides
# On Vercel, configure these in Project Settings -> Environment Variables
# ========================================================

# General Application Info
VITE_APP_NAME="GiftX"
VITE_APP_DESCRIPTION="The Modern Intelligent Gifting & Wishlist Platform"
VITE_APP_URL="https://giftx.vercel.app"

# API & Backend Configuration (optional / mock fallback enabled)
VITE_API_BASE_URL="https://api.giftx.example.com/v1"
VITE_API_TIMEOUT_MS=10000

# Feature Flags
VITE_ENABLE_AI_GIFT_FINDER=true
VITE_ENABLE_SECRET_SANTA=true
VITE_ENABLE_WISHLIST_SHARING=true

# Analytics & Monitoring (Optional)
VITE_VERCEL_ANALYTICS_ENABLED=true
VITE_GA_TRACKING_ID=""
